void show_main_window() {
	uint flags = 0;
	if (!system_is_mobile) flags = MAIN_WINDOW_FLAGS_DESKTOP;
	show_window("Exkrementus", flags);
}

class excrement_object {
	int x;
	int y;
	int kind;
	uint64 spawned_at_ms;
	sound loop_sound;
	bool loop_loaded;
	bool loop_started;
	excrement_object(int x, int y, int kind) {
		this.x = x;
		this.y = y;
		this.kind = kind;
		this.spawned_at_ms = get_now_ms();
		this.loop_loaded = false;
		this.loop_started = false;
	}
}

