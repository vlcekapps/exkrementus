uint64 get_now_ms() {
	timestamp current_time;
	int64 current_time_us = current_time;
	if (current_time_us <= 0) return 0;
	return uint64(current_time_us / MILLISECONDS);
}

bool safe_sound_load(sound@ target, string path) {
	try {
		return target.load(path);
	} catch {
		return false;
	}
}

bool safe_sound_play(sound@ target) {
	try {
		return target.play();
	} catch {
		return false;
	}
}

bool safe_sound_play_looped(sound@ target) {
	try {
		return target.play_looped();
	} catch {
		return false;
	}
}

bool safe_sound_set_fade(sound@ target, int from_volume, int to_volume, int duration_ms) {
	try {
		target.set_fade(from_volume, to_volume, duration_ms);
		return true;
	} catch {
		return false;
	}
}

void safe_sound_stop(sound@ target) {
	try {
		target.stop();
	} catch {
	}
}

void safe_sound_close(sound@ target) {
	try {
		target.close();
	} catch {
	}
}

bool safe_sound_playing(sound@ target) {
	try {
		return target.playing;
	} catch {
		return false;
	}
}

void main() {
	show_main_window();
	load_audio_assets();
	ensure_touch_controls();
	run_main_menu();
}

